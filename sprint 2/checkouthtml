<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Checkout</title>
<script src="https://js.stripe.com/v3/"></script>
<style>
body {
    background: linear-gradient(135deg,#06194e,#7ebbd3,#4c07c3);
    font-family: Arial, sans-serif;
    margin:20px;
    color:white;
}
.navbar { 
    background:#232760; 
    padding:10px; 
    border-radius:10px; 
    margin-bottom:20px; 
    display: flex;
    gap: 15px;
}
.navbar a { 
    color:white; 
    text-decoration:none; 
}

#checkout-container { 
    display:flex; 
    justify-content:space-between; 
    margin-top:30px; 
}
#left-section { 
    width:35%; 
    display:flex; 
    align-items:center; 
    justify-content:center; 
    font-size:1.5rem; 
    text-align:center;
    background: rgba(255,255,255,0.1);
    border-radius:10px;
    padding:20px;
}
#items-section { 
    width:60%; 
}
.item { 
    background: rgba(255,255,255,0.15); 
    padding:15px; 
    margin:10px 0; 
    border-radius:8px; 
    display:flex; 
    align-items:center; 
}
.item-image { 
    width:60px; 
    height:60px; 
    object-fit:cover; 
    border-radius:6px; 
    margin-right:15px; 
    border: 1px solid rgba(255,255,255,0.3);
}
.item-details { 
    flex-grow:1; 
}
.item-details strong {
    font-size: 1.1rem;
}
.item-details span {
    color: #a7b4d8;
    font-weight: bold;
}
#checkout-header { 
    font-size:1.5rem; 
    margin-bottom:20px;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    padding-bottom: 10px;
}
#stylx-title { 
    font-size:2rem; 
    font-weight:bold; 
    margin-bottom:5px;
    color: #ffffff;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
.btn-pay { 
    padding:12px 20px; 
    font-size:1.1rem; 
    border-radius:8px; 
    cursor:pointer; 
    background-color:#20157e; 
    color:white; 
    border:none; 
    margin-top:20px;
    width: 100%;
    transition: background 0.3s;
}
.btn-pay:hover {
    background-color: #2f1fa3;
}
.btn-pay:disabled {
    background-color: #666;
    cursor: not-allowed;
}
.total-price {
    margin-top: 20px;
    padding: 15px;
    background: rgba(0,0,0,0.3);
    border-radius: 8px;
    font-size: 1.2rem;
    font-weight: bold;
    text-align: right;
    border: 1px solid rgba(255,255,255,0.2);
}
.empty-cart {
    text-align: center;
    padding: 40px;
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
    font-size: 1.2rem;
}
.empty-cart a {
    color: #a7b4d8;
    text-decoration: none;
    display: inline-block;
    margin-top: 15px;
    padding: 10px 20px;
    background: #20157e;
    border-radius: 5px;
    color: white;
}
.empty-cart a:hover {
    background: #2f1fa3;
}
.loading {
    text-align: center;
    padding: 40px;
    font-size: 1.2rem;
    color: #a7b4d8;
}
.debug-info {
    background: rgba(0,0,0,0.5);
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    font-size: 0.9rem;
    color: #ff0;
    display: none; /* Hide by default, remove this line to see debug info */
}
</style>
</head>
<body>

<nav class="navbar">
    <a href="index.html">Home</a>
    <a href="shoptest.html">Continue Shopping</a>
</nav>

<div id="checkout-container">
    <div id="left-section">
        <div>
            <h2>Your Closet Upgrade Waits!</h2>
            <p>Complete your purchase to get these stylish items delivered to your doorstep.</p>
        </div>
    </div>

    <div id="items-section">
        <div id="stylx-title">Stylx</div>
        <div id="checkout-header">Checkout</div>
        
        <!-- Debug info -->
        <div id="debug-info" class="debug-info"></div>
        
        <div id="items-list">
            <div class="loading">Loading your cart...</div>
        </div>
    </div>
</div>

<script>
//stripe public key
const stripePublicKey = 'pk_test_51T71NELl3DkYMLqeTi6Bm164r3frBmAIlSdZ3MJswFTg2nnpNE4lfg9zQiKfEEjIuwdRPlthmgh1fOCrSBxlTOwa00qofvcZbZ';

function debug(message) {
    console.log("DEBUG:", message);
    const debugEl = document.getElementById('debug-info');
    if (debugEl) {
        debugEl.innerHTML += `<div>${new Date().toLocaleTimeString()}: ${message}</div>`;
    }
}

async function loadCartItems() {
    debug("Loading cart items...");
    
    // Get cart from localStorage
    const cartRaw = localStorage.getItem("cart");
    debug(`Raw cart data: ${cartRaw}`);
    
    let cart = [];
    try {
        cart = JSON.parse(cartRaw) || [];
    } catch (e) {
        debug(`Error parsing cart: ${e.message}`);
        cart = [];
    }
    
    debug(`Parsed cart array: ${JSON.stringify(cart)}`);
    debug(`Cart length: ${cart.length}`);
    
    const itemsList = document.getElementById("items-list");
    
    if (cart.length === 0) {
        debug("Cart is empty, showing empty message");
        itemsList.innerHTML = `
            <div class="empty-cart">
                <p>Your cart is empty.</p>
                <a href="shoptest.html">Start Shopping</a>
            </div>
        `;
        return;
    }

    try {
        debug(`Fetching cart items from server for IDs: ${JSON.stringify(cart)}`);
        
        // get cart item info
        const response = await fetch("/get-cart-items", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ cart })
        });

        debug(`Server response status: ${response.status}`);
        
        if (!response.ok) {
            const errorText = await response.text();
            debug(`Error response: ${errorText}`);
            throw new Error(`Failed to fetch cart items: ${response.status}`);
        }
        
        const data = await response.json();
        debug(`Server returned items: ${JSON.stringify(data)}`);
        
        //loading message
        itemsList.innerHTML = "";
        
        if (!data.items || data.items.length === 0) {
            debug("No items found from server");
            itemsList.innerHTML = `
                <div class="empty-cart">
                    <p>no items in cart. The items in your cart may no longer be available.</p>
                    <a href="shoptest.html">Continue Shopping</a>
                </div>
            `;
            return;
        }
        
        debug(`Displaying ${data.items.length} items`);
        
        let totalPrice = 0;
        
        // display cart items
        data.items.forEach((item, index) => {
            debug(`Item ${index}: ${item.item_name} - $${item.price}`);
            
            const div = document.createElement("div");
            div.classList.add("item");
            div.innerHTML = `
                <img src="${item.image_url || 'https://via.placeholder.com/60'}" class="item-image" alt="${item.item_name}" onerror="this.src='https://via.placeholder.com/60'">
                <div class="item-details">
                    <strong>${item.item_name}</strong><br>
                    <span>$${parseFloat(item.price).toFixed(2)}</span>
                    ${item.brand_name ? `<br><small>${item.brand_name}</small>` : ''}
                </div>
            `;
            itemsList.appendChild(div);
            totalPrice += parseFloat(item.price);
        });
        
        debug(`Total price: $${totalPrice.toFixed(2)}`);
        
        // total price
        const totalDiv = document.createElement("div");
        totalDiv.classList.add("total-price");
        totalDiv.innerHTML = `Total: $${totalPrice.toFixed(2)}`;
        itemsList.appendChild(totalDiv);
        
        //checkout button
        const button = document.createElement("button");
        button.classList.add("btn-pay");
        button.textContent = "Proceed to Payment";
        button.onclick = async () => {
            // Disable button to prevent double clicks
            button.disabled = true;
            button.textContent = "Processing...";
            
            try {
                debug("Creating Stripe checkout session...");
                const stripe = Stripe(stripePublicKey);
                
                // Create checkout session
                const sessionResponse = await fetch("/create-checkout-session", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ cart })
                });
                
                debug(`Session response status: ${sessionResponse.status}`);
                
                if (!sessionResponse.ok) {
                    const errorText = await sessionResponse.text();
                    debug(`Session error: ${errorText}`);
                    throw new Error("Failed to create checkout session");
                }
                
                const sessionData = await sessionResponse.json();
                debug(`Session created: ${sessionData.sessionId}`);
                
                // Redirect to Stripe Checkout
                const { error } = await stripe.redirectToCheckout({ 
                    sessionId: sessionData.sessionId 
                });
                
                if (error) {
                    debug(`Stripe redirect error: ${error.message}`);
                    alert(error.message);
                    button.disabled = false;
                    button.textContent = "Proceed to Payment";
                }
            } catch (error) {
                debug(`Checkout error: ${error.message}`);
                console.error("Checkout error:", error);
                alert("Error processing checkout: " + error.message);
                button.disabled = false;
                button.textContent = "Proceed to Payment";
            }
        };
        itemsList.appendChild(button);

    } catch (err) {
        debug(`Error loading cart: ${err.message}`);
        console.error("Error loading cart:", err);
        itemsList.innerHTML = `
            <div class="empty-cart">
                <p>Error loading cart items. Please try again.</p>
                <button onclick="loadCartItems()" style="padding:10px 20px; background:#20157e; color:white; border:none; border-radius:5px; cursor:pointer; margin-top:10px;">Retry</button>
                <br>
                <a href="shoptest.html" style="display:inline-block; margin-top:15px; color:#a7b4d8;">Continue Shopping</a>
            </div>
        `;
    }
}
//load items when page loads
debug("Page loaded, starting cart load");
loadCartItems();

// Listen for cart updates from other tabs
window.addEventListener("storage", (event) => {
    debug(`Storage event detected: ${event.key} changed`);
    if (event.key === "cart") {
        debug("Cart changed in another tab, reloading...");
        loadCartItems();
    }
});

//listen for manual storage events from the same tab
window.addEventListener("cart-updated", () => {
    debug("Cart updated in this tab, reloading...");
    loadCartItems();
});
</script>

</body>
</html>
